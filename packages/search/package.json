{
  "name": "@flesh-and-blood/search",
  "description": "TypeScript search engine for Flesh and Blood cards",
  "version": "5.3.0",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./abbreviations": {
      "types": "./dist/abbreviations.d.ts",
      "import": "./dist/abbreviations.js"
    },
    "./shorthands": {
      "types": "./dist/shorthands.d.ts",
      "import": "./dist/shorthands.js"
    },
    "./memes": {
      "types": "./dist/memes.d.ts",
      "import": "./dist/memes.js"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "esbuild src/*.ts --outdir=dist --format=esm --platform=neutral --target=es2020",
    "build:cjs": "esbuild src/index.ts --outfile=dist/index.cjs --bundle --minify --format=cjs --platform=node --target=es2020 --external:@flesh-and-blood/types --external:fuse.js",
    "postbuild": "tsc --declaration",
    "test": "vitest run",
    "test:specific": "vitest run -t 'Matching printing from treatment'",
    "update:snapshots": "vitest run -u",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "full": "npm run build && npm test",
    "prepublish": "npm run full",
    "prepublishOnly": "npm run typecheck"
  },
  "dependencies": {
    "fuse.js": "^7.5.0"
  },
  "peerDependencies": {
    "@flesh-and-blood/types": "^5.0.0"
  },
  "devDependencies": {
    "@flesh-and-blood/cards": "^5.3.0",
    "@flesh-and-blood/types": "^5.3.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabrary/fab-cards.git"
  },
  "bugs": {
    "url": "https://github.com/fabrary/fab-cards/issues"
  },
  "homepage": "https://github.com/fabrary/fab-cards#readme",
  "author": "Phillip Manwaring",
  "license": "MIT",
  "keywords": [
    "Flesh and Blood",
    "FAB",
    "FABTCG"
  ],
  "gitHead": "9ce9831f9bc1ccd6708bb6fe292a16650385e7f6"
}
