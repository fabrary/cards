{
  "name": "@flesh-and-blood/root",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "clean:csvs": "npm run clean:csvs -w @flesh-and-blood/cards",
    "full": "lerna run full",
    "lint": "oxlint --type-aware --deny-warnings",
    "publish": "npm login && lerna publish --no-progress",
    "publish:legacy": "npm login --auth-type=legacy && lerna publish --no-progress",
    "postpack": "FORCE_COLOR=1 node packages/cards/tests/new-and-removed-cards.ts",
    "test": "lerna run test",
    "typecheck": "lerna run typecheck",
    "update:snapshots": "lerna run update:snapshots",
    "prepare": "husky",
    "knip": "knip"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lerna": "^10.0.1",
    "lint-staged": "^17.0.8",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.5"
  }
}
