{
  "name": "@flesh-and-blood/root",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "clean:csvs": "npm run clean:csvs -w @flesh-and-blood/cards",
    "full": "lerna run full",
    "lint": "oxlint",
    "publish": "npm login && lerna publish",
    "publish:legacy": "npm login --auth-type=legacy && lerna publish",
    "test": "lerna run test",
    "typecheck": "lerna run typecheck",
    "update:snapshots": "lerna run update:snapshots",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lerna": "^8.0.1",
    "lint-staged": "^17.0.8",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.5"
  }
}
